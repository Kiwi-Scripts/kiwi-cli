{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "paths": {
      "@commands/*": ["./src/lib/commands/own/*"],
      "@lib/*": ["./src/lib/*"],
      "templates": ["./src/lib/templates/template.registry"],
      "@kiwi-js/cli": ["./src/index.ts"],
      "@kiwi-js/cli/api": ["./src/api.ts"]
    },
    "types": [
      "node"
    ]
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test.json" }
  ]
}